# Ellines Rattan Furniture — environment reference
#
# HOSTING: Cloudflare Pages (rattanfurniture.ellines.co.ke)
# DATABASE: Firebase project `ellines-haven-web` (shared with Ellines Haven)
#
# IMPORTANT: Rattan data is namespaced so it does not collide with Haven:
#   site_data/rattan_admin_credentials
#   site_data/rattan_admin_settings
#   site_data/products_catalogue
#   rattan_users/
#   quote_requests/
#
# Copy to `.env` (gitignored) for local builds. For Cloudflare Pages, add the
# same VITE_* keys under Settings → Environment variables (needed at build time).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ellines-haven-web.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ellines-haven-web
VITE_FIREBASE_STORAGE_BUCKET=ellines-haven-web.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Super admin email — first login seeds rattan_admin_credentials in Firestore
VITE_SUPER_ADMIN_EMAIL=info@ellines.co.ke

# Optional: local-only admin password when Firebase env is not configured (dev only)
VITE_DEV_ADMIN_PASSWORD=
