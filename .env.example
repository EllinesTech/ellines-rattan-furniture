# Firebase — create a project at https://console.firebase.google.com
# Enable Authentication (Email/Password optional) and Firestore.
# Add your Cloudflare Pages domain to Firebase authorized domains.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Super admin email — first login seeds admin_credentials in Firestore
VITE_SUPER_ADMIN_EMAIL=info@ellines.co.ke

# Optional: local-only admin password when Firebase env is not configured (dev only)
VITE_DEV_ADMIN_PASSWORD=
