rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Ellines Rattan Furniture (shared project ellines-haven-web) ─────────
    // Merge these blocks into Haven's live rules before deploying.
    // Privileged writes require Firebase Auth (synced on app login).

    function signedIn() {
      return request.auth != null;
    }

    function isValidEmail(value) {
      return value is string && value.size() > 3 && value.size() < 320;
    }

    match /site_data/{docId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /rattan_users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if signedIn();
    }

    match /quote_requests/{requestId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAny(['customer', 'items'])
        && request.resource.data.customer is map;
      allow update, delete: if signedIn();
    }

    match /rattan_orders/{orderId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /rattan_media/{mediaId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /rattan_subscriptions/{subId} {
      allow read: if signedIn();
      allow create: if request.resource.data.email is string
        && isValidEmail(request.resource.data.email);
      allow update, delete: if signedIn();
    }

    match /rattan_testimonials/{id} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /rattan_posts/{id} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /rattan_visit_bookings/{id} {
      allow read: if signedIn();
      allow create: if request.resource.data.keys().hasAny(['name', 'phone'])
        && request.resource.data.name is string
        && request.resource.data.phone is string;
      allow update, delete: if signedIn();
    }

    match /rattan_trade_enquiries/{id} {
      allow read: if signedIn();
      allow create: if request.resource.data.keys().hasAny(['name', 'phone'])
        && request.resource.data.name is string
        && request.resource.data.phone is string;
      allow update, delete: if signedIn();
    }
  }
}
