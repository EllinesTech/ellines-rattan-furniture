rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Ellines Rattan Furniture (shared project ellines-haven-web) ─────────
    // These rules are the Rattan *additions* expected in the live project.
    // DO NOT deploy this file alone over Haven — it would wipe Haven rules.
    // Deploy via Haven's firestore.rules (which merges Haven + Rattan rules),
    // or paste the Rattan match blocks into the Firebase Console.

    // Site config docs used by Rattan (and Haven). Doc IDs are namespaced
    // where they would collide (rattan_admin_credentials, rattan_admin_settings).
    match /site_data/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Rattan portal users (clients / staff) — NOT Haven's `users` collection.
    match /rattan_users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Customer quote submissions and admin/staff status updates.
    match /quote_requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    match /rattan_orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    match /rattan_media/{mediaId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    match /rattan_subscriptions/{subId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}
